# Python bytecode
__pycache__/
*.py[cod]

# Editor / IDE
.vscode/

# Training outputs (regenerable: checkpoints, per-run snapshots, plots).
# Keep models/.gitkeep so the directory stays in the tree.
/models/*
!/models/.gitkeep

# Run logs dropped at the repo root (train/eval stdout). Regenerable and huge — a 500k-trial
# training log is ~10 MB of "Trial n/N". Root-level only: probes/*.log are deliberate artefacts
# of a probe write-up and stay tracked.
/*.log

# RUN RESULTS ARE NEVER COMMITTED. Harness stdout belongs in /results/ (untracked); the numbers
# that matter get transcribed into RESEARCH_LOG.md, which is the record. Before 2026-07-19 three
# *_results.txt files were tracked at the repo root — not by decision, but because /*.log above
# ignores root logs while nothing ignored root .txt, so `git add` swept them in. They were
# uncited by any doc and have been removed. The scripts that produce them live in /runs/ and
# ARE tracked (small, and they document how a number was obtained).
/results/
*_results.txt

# Training progress logs: one line per trial (100k+ lines), regenerable, and train.py
# already tees a copy into models/run<ts>/train.log (gitignored). Never commit these.
probes/**/r6_*_full.log
probes/**/r6_L*.log
probes/**/tune.log
